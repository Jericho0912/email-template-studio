# Local send server configuration. Copy to .env (git-ignored) and adjust.
# Credentials are NOT set here: the AWS SDK reads them from your AWS profile
# (~/.aws/credentials) or from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars.

# Master switch. Anything other than "true" keeps the server in disabled mode.
STUDIO_SEND_ENABLED=true
# true = exercise the whole path but never call SES (returns dry-run-N message ids).
# Fail-safe default: set to false only when you are ready to send for real.
STUDIO_SEND_DRY_RUN=true

# Which AWS profile / region hold your SES identities (identities are per region).
# Leave AWS_PROFILE out to use the default profile or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
AWS_PROFILE=default
AWS_REGION=us-east-1

# A verified SES identity to send from, and the only addresses tests may go to.
SES_FROM_ADDRESS=verified-sender@example.com
SES_ALLOWED_RECIPIENTS=you@example.com,teammate@example.com
# SES_CONFIGURATION_SET=

STUDIO_SERVER_PORT=8787
STUDIO_SEND_RATE_LIMIT_PER_MINUTE=5
